from datetime import datetime, timezone

from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.orm import Session

from app.database import SessionLocal
from app.models import LocationEvent
from app.services.geo_engine import analyze_location
from app.services.risk_engine import analyze_movement


router = APIRouter(
    prefix="/locations",
    tags=["Locations"]
)


def get_db():
    db = SessionLocal()

    try:
        yield db
    finally:
        db.close()


@router.post("/analyze")
def analyze(
    latitude: float,
    longitude: float,
    accuracy: float,
    source: str,
    db: Session = Depends(get_db)
):
    # Validate and analyze the incoming location.
    try:
        result = analyze_location(
            latitude,
            longitude,
            accuracy,
            source
        )
    except ValueError as error:
        raise HTTPException(
            status_code=422,
            detail=str(error)
        )

    # Find the most recent location for this user.
    user_id = 1

    previous_location = (
        db.query(LocationEvent)
        .filter(LocationEvent.user_id == user_id)
        .order_by(LocationEvent.timestamp.desc())
        .first()
    )

    # Use UTC for the new timestamp.
    # Store it without timezone information to match
    # the existing database model's datetime convention.
    current_timestamp = datetime.now(
        timezone.utc
    ).replace(tzinfo=None)

    movement_analysis = None

    # A first location has no previous record to compare.
    if (
        previous_location is not None
        and previous_location.timestamp is not None
    ):
        try:
            movement_analysis = analyze_movement(
                previous_latitude=previous_location.latitude,
                previous_longitude=previous_location.longitude,
                previous_timestamp=previous_location.timestamp,
                current_latitude=latitude,
                current_longitude=longitude,
                current_timestamp=current_timestamp
            )
        except ValueError as error:
            raise HTTPException(
                status_code=422,
                detail=f"Movement analysis failed: {error}"
            )

    # Prepare the database record.
    location_event = LocationEvent(
        user_id=user_id,
        latitude=latitude,
        longitude=longitude,
        accuracy=accuracy,
        source=source,
        confidence=result["confidence"],
        location=f"SRID=4326;POINT({longitude} {latitude})",
        timestamp=current_timestamp
    )

    try:
        db.add(location_event)
        db.commit()
        db.refresh(location_event)
    except Exception:
        db.rollback()
        raise HTTPException(
            status_code=500,
            detail="Failed to save location"
        )

    # Return the location and movement assessment.
    return {
        "id": location_event.id,
        "latitude": location_event.latitude,
        "longitude": location_event.longitude,
        "accuracy_meters": location_event.accuracy,
        "confidence": location_event.confidence,
        "source": location_event.source,
        "timestamp": location_event.timestamp,
        "status": "location saved",
        "movement_analysis": movement_analysis
    }


@router.get("/history/{user_id}")
def location_history(
    user_id: int,
    db: Session = Depends(get_db)
):
    locations = (
        db.query(LocationEvent)
        .filter(LocationEvent.user_id == user_id)
        .order_by(LocationEvent.timestamp.desc())
        .all()
    )

    return [
        {
            "id": location.id,
            "latitude": location.latitude,
            "longitude": location.longitude,
            "accuracy_meters": location.accuracy,
            "confidence": location.confidence,
            "source": location.source,
            "timestamp": location.timestamp
        }
        for location in locations
    ]

@router.get("/risk/{user_id}")
def location_risk_assessment(
    user_id: int,
    db: Session = Depends(get_db)
):
    """
    Assess movement risk using the two most recent
    saved location records for a user.
    """

    # Retrieve the two most recent location records.
    locations = (
        db.query(LocationEvent)
        .filter(LocationEvent.user_id == user_id)
        .order_by(LocationEvent.timestamp.desc())
        .limit(2)
        .all()
    )

    # We need two records to calculate movement.
    if len(locations) < 2:
        return {
            "user_id": user_id,
            "risk_level": "UNKNOWN",
            "status": "insufficient_data",
            "reason": (
                "At least two saved location records "
                "are required to assess movement."
            )
        }

    # The first record is the newest.
    current = locations[0]

    # The second record is the previous location.
    previous = locations[1]

    try:
        movement = analyze_movement(
            previous_latitude=previous.latitude,
            previous_longitude=previous.longitude,
            previous_timestamp=previous.timestamp,
            current_latitude=current.latitude,
            current_longitude=current.longitude,
            current_timestamp=current.timestamp
        )

    except ValueError as error:
        raise HTTPException(
            status_code=422,
            detail=str(error)
        )

    # Combine movement findings with the latest
    # location's rule-based confidence score.
    if movement["suspicious_movement"]:
        risk_level = "HIGH"
        recommendation = (
            "Flag for further review. Check location accuracy, "
            "timestamps, and other available evidence."
        )

    elif current.confidence < 0.60:
        risk_level = "MEDIUM"
        recommendation = (
            "Review the reliability of the latest location "
            "before relying on it."
        )

    else:
        risk_level = "LOW"
        recommendation = (
            "No movement threshold violation was detected. "
            "Continue normal monitoring."
        )

    return {
        "user_id": user_id,
        "risk_level": risk_level,
        "status": "assessment_complete",
        "previous_location_id": previous.id,
        "current_location_id": current.id,
        "location_confidence": current.confidence,
        "location_accuracy_meters": current.accuracy,
        "movement_analysis": movement,
        "recommendation": recommendation
    }
