from math import radians, sin, cos, sqrt, atan2


def calculate_distance(
    latitude1: float,
    longitude1: float,
    latitude2: float,
    longitude2: float
) -> float:
    """
    Calculate the approximate distance between
    two geographic coordinates, in kilometres.
    """

    earth_radius = 6371.0

    lat1 = radians(latitude1)
    lat2 = radians(latitude2)

    difference_latitude = radians(latitude2 - latitude1)
    difference_longitude = radians(longitude2 - longitude1)

    a = (
        sin(difference_latitude / 2) ** 2
        + cos(lat1)
        * cos(lat2)
        * sin(difference_longitude / 2) ** 2
    )

    # Protect against small floating-point rounding errors.
    a = max(0.0, min(1.0, a))

    c = 2 * atan2(sqrt(a), sqrt(1 - a))

    return earth_radius * c


def analyze_movement(
    previous_latitude: float,
    previous_longitude: float,
    previous_timestamp,
    current_latitude: float,
    current_longitude: float,
    current_timestamp,
    max_speed_kmh: float = 1000.0
) -> dict:
    """
    Assess whether movement between two location
    records appears physically implausible.

    This is a screening rule, not proof of fraud.
    """

    # Validate the speed threshold.
    if max_speed_kmh <= 0:
        raise ValueError("Maximum speed must be positive")

    # Validate the coordinates.
    for latitude in (previous_latitude, current_latitude):
        if not -90 <= latitude <= 90:
            raise ValueError("Latitude must be between -90 and 90")

    for longitude in (previous_longitude, current_longitude):
        if not -180 <= longitude <= 180:
            raise ValueError("Longitude must be between -180 and 180")

    # Ensure timestamps can be compared.
    if (
        previous_timestamp.tzinfo != current_timestamp.tzinfo
        and (
            previous_timestamp.tzinfo is not None
            or current_timestamp.tzinfo is not None
        )
    ):
        raise ValueError(
            "Both timestamps must use compatible time zones"
        )

    elapsed_seconds = (
        current_timestamp - previous_timestamp
    ).total_seconds()

    # Reject duplicate, reversed, or invalid time intervals.
    if elapsed_seconds <= 0:
        raise ValueError(
            "Current timestamp must be later than previous timestamp"
        )

    distance_km = calculate_distance(
        previous_latitude,
        previous_longitude,
        current_latitude,
        current_longitude
    )

    elapsed_hours = elapsed_seconds / 3600

    required_speed_kmh = distance_km / elapsed_hours

    suspicious = required_speed_kmh > max_speed_kmh

    if suspicious:
        risk_level = "HIGH"
        reason = (
            "The movement requires a speed above the configured "
            "plausibility threshold."
        )
    else:
        risk_level = "LOW"
        reason = (
            "The movement did not exceed the configured "
            "speed threshold."
        )

    return {
        "distance_km": round(distance_km, 2),
        "elapsed_seconds": round(elapsed_seconds, 2),
        "required_speed_kmh": round(required_speed_kmh, 2),
        "risk_level": risk_level,
        "suspicious_movement": suspicious,
        "reason": reason
    }