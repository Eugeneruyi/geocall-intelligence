/* =====================================================
   GeoCall Intelligence — stylesheet matching index.html
   ===================================================== */

:root {
    color-scheme: dark;
    --page: #0b1220;
    --sidebar: #0f1828;
    --panel: #111c2e;
    --panel-soft: #0f1929;
    --border: #26354b;
    --text: #edf3fc;
    --muted: #91a1b8;
    --muted-2: #71839d;
    --blue: #64a9ff;
    --green: #39d5a2;
    --yellow: #f0b85a;
    --red: #ff5d70;
    --orange: #ff9d66;
}

* { box-sizing: border-box; }
html { min-height: 100%; scroll-behavior: smooth; scroll-padding-top: 20px; }
body {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    background: var(--page);
    color: var(--text);
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    font-size: 14px;
    line-height: 1.5;
}
button, input, select, textarea { font: inherit; }
button { cursor: pointer; }
a { color: inherit; }

/* Overall two-column layout */
.app-container {
    display: flex;
    align-items: stretch;
    min-height: 100vh;
    width: 100%;
}

/* Sidebar */
.sidebar {
    display: flex;
    flex: 0 0 248px;
    flex-direction: column;
    width: 248px;
    min-width: 248px;
    min-height: 100vh;
    background: var(--sidebar);
    border-right: 1px solid var(--border);
}
.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 24px 20px;
    border-bottom: 1px solid var(--border);
}
.brand-icon {
    display: grid;
    flex: 0 0 40px;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid #34527a;
    border-radius: 10px;
    background: #172a45;
    color: var(--blue);
    font-size: 23px;
    font-weight: 800;
}
.brand h2 { margin: 0; font-size: 19px; line-height: 1.2; letter-spacing: .2px; }
.brand p { margin: 5px 0 0; color: var(--muted); font-size: 10px; letter-spacing: 2px; }
.nav-label {
    padding: 22px 20px 10px;
    color: var(--muted-2);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
}
.sidebar nav { display: flex; flex-direction: column; gap: 5px; padding: 8px 12px 16px; }
.nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 11px 13px;
    border: 1px solid transparent;
    border-radius: 8px;
    color: var(--muted);
    text-decoration: none;
    font-size: 13px;
    transition: background .15s ease, color .15s ease, border-color .15s ease;
}
.nav-item span { display: inline-grid; flex: 0 0 20px; place-items: center; width: 20px; font-size: 17px; }
.nav-item:hover { background: #17243a; color: var(--text); }
.nav-item.active { background: #1b2a42; border-color: #2a405e; color: var(--text); }
.sidebar-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding: 18px 16px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
}
.sidebar-footer strong { margin-left: auto; color: var(--green); font-size: 10px; letter-spacing: .7px; }
.status-dot {
    display: inline-block;
    flex: 0 0 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 9px rgb(57 213 162 / 20%);
}

/* Main page and top header */
.main-content {
    flex: 1 1 auto;
    width: calc(100% - 248px);
    min-width: 0;
    padding: 28px 30px 20px;
}
.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin: 0 0 28px;
}
.topbar > div:first-child { min-width: 0; }
.breadcrumb { margin: 0 0 8px; color: var(--muted-2); font-size: 10px; font-weight: 700; letter-spacing: 1.4px; }
.topbar h1 { margin: 0; font-size: clamp(22px, 2.2vw, 29px); line-height: 1.25; letter-spacing: -.5px; }
.subtitle { margin: 8px 0 0; color: var(--muted); font-size: 13px; }
.topbar-actions { display: flex; flex: 0 0 auto; align-items: center; justify-content: flex-end; gap: 14px; }
.connection-status { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 12px; white-space: nowrap; }
.refresh-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 39px;
    padding: 9px 14px;
    border: 1px solid #34445b;
    border-radius: 8px;
    background: #17243a;
    color: var(--text);
    white-space: nowrap;
    transition: background .15s ease, border-color .15s ease;
}
.refresh-button:hover { background: #22344e; border-color: #49617f; }
.refresh-button:disabled { cursor: wait; opacity: .6; }

/* Risk overview */
.summary-section { margin-bottom: 25px; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 15px; }
.section-heading h2, .panel-header h2 { margin: 0; font-size: 16px; font-weight: 650; line-height: 1.35; }
.section-heading p, .panel-header p { margin: 5px 0 0; color: var(--muted); font-size: 12px; line-height: 1.5; }
.live-label { color: var(--green); font-size: 10px; font-weight: 700; letter-spacing: 1px; white-space: nowrap; }
.stats-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
.stat-card {
    min-width: 0;
    min-height: 140px;
    padding: 17px 16px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--panel);
}
.stat-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; color: var(--muted); font-size: 11px; line-height: 1.4; }
.stat-icon { display: grid; flex: 0 0 29px; place-items: center; width: 29px; height: 29px; border-radius: 8px; background: #1b2a42; color: var(--blue); font-size: 15px; }
.stat-card h3 { margin: 15px 0 7px; color: var(--text); font-size: 29px; line-height: 1.05; font-weight: 750; }
.stat-card > p { margin: 0; color: var(--muted-2); font-size: 10px; line-height: 1.45; }
.high-card h3 { color: var(--red); }
.medium-card h3 { color: var(--yellow); }
.low-card h3 { color: var(--green); }
.alert-card h3 { color: var(--orange); }

/* Common panels */
.panel { min-width: 0; margin: 0 0 24px; overflow: hidden; border: 1px solid var(--border); border-radius: 11px; background: var(--panel); }
.panel-header { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 19px 22px; border-bottom: 1px solid var(--border); }
.panel-count, .table-note { color: var(--muted); font-size: 11px; white-space: nowrap; }

/* Map and legend */
#location-map-panel { scroll-margin-top: 18px; }
#geo-map { position: relative; z-index: 1; width: 100%; height: 420px; min-height: 300px; background: #17243a; }
.map-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; padding: 14px 22px; border-bottom: 1px solid var(--border); }
.legend-item { display: inline-flex; align-items: center; gap: 8px; color: #aab8cb; font-size: 11px; }
.legend-dot { display: inline-block; flex: 0 0 9px; width: 9px; height: 9px; border-radius: 50%; }
.location-dot { background: var(--green); }
.high-risk-dot { background: var(--red); }

/* Movement analysis */
.movement-details { padding: 21px 22px 22px; }
.movement-details > h3 { margin: 0; font-size: 15px; }
.movement-intro { margin: 6px 0 17px; color: var(--muted); font-size: 12px; line-height: 1.6; }
.movement-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
.movement-stat { display: flex; flex-direction: column; justify-content: center; gap: 8px; min-width: 0; min-height: 86px; padding: 14px; border: 1px solid var(--border); border-radius: 8px; background: var(--panel-soft); }
.movement-stat span { color: var(--muted); font-size: 11px; }
.movement-stat strong { color: var(--text); font-size: 17px; line-height: 1.3; overflow-wrap: anywhere; }
.movement-reason { margin-top: 14px; padding: 15px 16px; border: 1px solid #263c59; border-left: 3px solid var(--blue); border-radius: 7px; background: var(--panel-soft); }
.movement-reason > strong { font-size: 12px; }
.movement-reason p { margin: 7px 0 0; color: #aab8cb; font-size: 12px; line-height: 1.7; overflow-wrap: anywhere; }

/* Security alerts (styles support JS-generated content) */
.alerts-container { padding: 4px 22px; }
.alert-item { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; align-items: start; gap: 14px; padding: 17px 0; border-bottom: 1px solid #223047; }
.alert-item:last-child { border-bottom: 0; }
.alert-icon { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 9px; background: rgb(255 93 112 / 12%); color: var(--red); font-size: 17px; }
.alert-content { min-width: 0; }
.alert-content h3 { margin: 0 0 5px; color: var(--text); font-size: 13px; line-height: 1.45; overflow-wrap: anywhere; }
.alert-content p { margin: 4px 0; color: var(--muted); font-size: 12px; line-height: 1.6; overflow-wrap: anywhere; }
.alert-score { color: var(--red); font-size: 14px; font-weight: 750; white-space: nowrap; }
.loading-message, .empty-state { padding: 23px 10px; color: var(--muted); text-align: center; font-size: 12px; }

/* Assessment table */
.table-wrapper { width: 100%; overflow-x: auto; }
.table-wrapper table { width: 100%; min-width: 900px; border-collapse: collapse; }
.table-wrapper thead { background: var(--panel-soft); }
.table-wrapper th { padding: 13px 15px; border-bottom: 1px solid var(--border); color: var(--muted); text-align: left; font-size: 10px; font-weight: 700; letter-spacing: .5px; white-space: nowrap; }
.table-wrapper td { padding: 14px 15px; border-bottom: 1px solid #202e43; color: #b6c3d5; text-align: left; vertical-align: top; font-size: 12px; line-height: 1.55; }
.table-wrapper tbody tr:last-child td { border-bottom: 0; }
.table-wrapper tbody tr:hover { background: #131f32; }
.score-value { font-weight: 750; }
.score-high { color: var(--red); }
.score-medium { color: var(--yellow); }
.score-low { color: var(--green); }

/* Footer */
.footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 18px; padding: 3px 1px 10px; color: var(--muted-2); font-size: 11px; }

/* Keyboard focus */
a:focus-visible, button:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }

/* Tablet */
@media (max-width: 1250px) {
    .sidebar { flex-basis: 220px; width: 220px; min-width: 220px; }
    .main-content { width: calc(100% - 220px); padding: 24px 22px 18px; }
    .stats-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}

/* Small screens: navigation becomes a top section */
@media (max-width: 900px) {
    .app-container { flex-direction: column; }
    .sidebar { flex: 0 0 auto; width: 100%; min-width: 0; min-height: auto; border-right: 0; border-bottom: 1px solid var(--border); }
    .brand { padding: 15px 18px; }
    .nav-label { padding: 13px 18px 4px; }
    .sidebar nav { flex-direction: row; flex-wrap: wrap; gap: 5px; padding: 7px 12px 12px; }
    .nav-item { flex: 0 1 auto; min-height: 39px; padding: 9px 11px; }
    .sidebar-footer { display: none; }
    .main-content { width: 100%; padding: 22px; }
    .topbar { align-items: flex-start; }
    .topbar-actions { flex-wrap: wrap; }
    .movement-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #geo-map { height: 380px; }
}

/* Mobile */
@media (max-width: 600px) {
    .main-content { padding: 17px 13px; }
    .topbar { flex-direction: column; gap: 16px; margin-bottom: 22px; }
    .topbar h1 { font-size: 23px; }
    .topbar-actions { justify-content: flex-start; width: 100%; gap: 12px; }
    .connection-status { font-size: 11px; }
    .section-heading { align-items: flex-start; }
    .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .stat-card { min-height: 130px; padding: 14px 12px; }
    .stat-card h3 { font-size: 25px; }
    .stat-top { font-size: 10px; }
    .panel-header { align-items: flex-start; flex-direction: column; gap: 7px; padding: 16px; }
    #geo-map { height: 320px; min-height: 260px; }
    .map-legend { gap: 12px; padding: 12px 15px; }
    .movement-details { padding: 17px 14px; }
    .movement-stats { gap: 9px; }
    .movement-stat { min-height: 78px; padding: 12px; }
    .movement-stat strong { font-size: 15px; }
    .alerts-container { padding: 3px 15px; }
    .alert-item { grid-template-columns: 32px minmax(0, 1fr); gap: 10px; }
    .alert-icon { width: 31px; height: 31px; }
    .alert-score { grid-column: 2; }
    .footer { flex-direction: column; }
}

@media (max-width: 380px) {
    .stats-grid, .movement-stats { grid-template-columns: 1fr; }
    .section-heading { flex-direction: column; }
    .nav-item { font-size: 12px; }
}
